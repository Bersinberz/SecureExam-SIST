{
  "name": "secure-exam-app",
  "version": "1.0.0",
  "description": "Secure Exam - Online Examination System",
  "main": "electron/main.js",
  "author": "Bersin",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT,ELECTRON\" -c \"green,blue,magenta\" \"npm run server\" \"npm run client\" \"npm run electron-wait\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "electron": "electron .",
    "electron-wait": "wait-on http://localhost:5173 --timeout 60000 && electron .",
    "electron:dev": "electron .",
    "build": "npm run build-client && npm run build-electron",
    "build-client": "cd client && npm run build",
    "build-electron": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^7.6.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.secureexam.app",
    "productName": "Secure Exam",

    "directories": {
      "output": "dist-electron"
    },

    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/**/*"
    ],

    "win": {
      "target": "nsis",
      "icon": "client/public/favicon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
